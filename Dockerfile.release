# syntax=docker/dockerfile:1

# Combined single-image release for the Open Valley public service.
#
# One image runs both processes: the read-only public API and the Next.js web
# server. The API binds to loopback only. The web server is the sole exposed
# port, so browser requests stay same-origin through the web service.
#
# Like Dockerfile.api, this file never uses `COPY . .`. Only source and the
# explicitly promoted public release artifacts enter the image.

# -----------------------------------------------------------------------------
# Stage 1: build the Next.js web application
# -----------------------------------------------------------------------------
FROM node:22-bookworm-slim AS frontend-builder

WORKDIR /app/web
# Evaluated by the Next.js server only. Browser code keeps using relative
# /api/baseline paths. The API runs beside the web server in this image.
ARG INTERNAL_BASELINE_API_URL=http://127.0.0.1:8998
ENV INTERNAL_BASELINE_API_URL=${INTERNAL_BASELINE_API_URL}

COPY web/package.json web/package-lock.json* ./
RUN npm ci
COPY web ./
# next.config.ts is TypeScript, so `next start` needs the typescript package at
# runtime. Keep it while pruning the rest of the build-only toolchain.
RUN npm run build \
    && cp -r node_modules/typescript /tmp/typescript-runtime \
    && npm prune --omit=dev \
    && cp -r /tmp/typescript-runtime node_modules/typescript

# -----------------------------------------------------------------------------
# Stage 2: install the Python runtime and public releases
# -----------------------------------------------------------------------------
FROM ghcr.io/astral-sh/uv:0.6-python3.12-bookworm-slim AS python-builder

WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY src ./src
COPY releases ./releases
RUN uv sync --frozen --no-dev --no-install-project

# -----------------------------------------------------------------------------
# Stage 3: runtime
# -----------------------------------------------------------------------------
FROM python:3.12-slim AS runtime

WORKDIR /app
ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONPATH=/app \
    OPENVALLEY_RUNTIME=public \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get install -y --no-install-recommends supervisor \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system openvalley \
    && useradd --system --gid openvalley --home /app openvalley

# Node runs only the Next.js server; npm is not needed at runtime.
COPY --from=frontend-builder /usr/local/bin/node /usr/local/bin/node

COPY --from=python-builder --chown=openvalley:openvalley /app/.venv /app/.venv
COPY --from=python-builder --chown=openvalley:openvalley /app/src /app/src
COPY --from=python-builder --chown=openvalley:openvalley /app/releases /app/releases

COPY --from=frontend-builder --chown=openvalley:openvalley /app/web/package.json /app/web/package.json
COPY --from=frontend-builder --chown=openvalley:openvalley /app/web/package-lock.json /app/web/package-lock.json
COPY --from=frontend-builder --chown=openvalley:openvalley /app/web/next.config.ts /app/web/next.config.ts
COPY --from=frontend-builder --chown=openvalley:openvalley /app/web/node_modules /app/web/node_modules
COPY --from=frontend-builder --chown=openvalley:openvalley /app/web/.next /app/web/.next
COPY --from=frontend-builder --chown=openvalley:openvalley /app/web/public /app/web/public

COPY --chown=openvalley:openvalley ops/supervisord.conf /app/ops/supervisord.conf

USER openvalley
EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
    CMD python -c "from urllib.request import urlopen; urlopen('http://127.0.0.1:3000/', timeout=3).read()"

CMD ["supervisord", "-c", "/app/ops/supervisord.conf"]
