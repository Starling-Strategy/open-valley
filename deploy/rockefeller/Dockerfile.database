FROM pgvector/pgvector:0.8.2-pg16@sha256:00ba258a66dac104fd5171074a0084462a64a1369d8513f3d0a634e2f24d15bc
# PostgreSQL peer authentication resolves kernel UIDs in this container.
# The web UID is deliberately different from the host operator's UID.
RUN useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin openvalley-web \
 && useradd --uid 1000 --no-create-home --shell /usr/sbin/nologin openvalley-operator \
 && install -d -m 0700 -o postgres -g postgres /var/lib/postgresql/data
COPY pg_hba.conf pg_ident.conf /etc/openvalley/
COPY --chmod=755 start-database.sh /usr/local/bin/openvalley-postgres
USER postgres
ENTRYPOINT ["/usr/local/bin/openvalley-postgres"]
