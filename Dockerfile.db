# Use official pgvector image which includes PostGIS
# Legacy Warren housing database image (pgvector + PostGIS).
# Retained for data rebuilds; the schools runtime does not use this file.
# See docs/housing-baseline.md.

FROM pgvector/pgvector:pg16

# The pgvector image is based on postgres:16
# We need to add PostGIS
RUN apt-get update && apt-get install -y \
    postgresql-16-postgis-3 \
    && rm -rf /var/lib/apt/lists/*
