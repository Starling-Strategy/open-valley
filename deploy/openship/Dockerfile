FROM ghcr.io/oblien/openship-api@sha256:38bdc73b58a7c5a4d04d6f84b1acc654c9409c008ce1c9bbb600032c87bf540d
RUN bun -e 'import {readFileSync,writeFileSync} from "node:fs"; import {createHash} from "node:crypto"; const p="/app/packages/adapters/src/runtime/docker-transport.ts"; const t=readFileSync(p,"utf8"); if(createHash("sha256").update(t).digest("hex")!=="7e95a0610cae5e19a200ee5937b8d899bd767d3c86ac3bd07bf35084fe49d1ad") throw new Error("Unexpected source revision"); const before="if (!opts.privateKey && !opts.sshAgent && !opts.password) {"; const after="// System OpenSSH owns authentication, including default identities and Tailscale SSH.\n    if (!opts.useSystemSsh && !opts.privateKey && !opts.sshAgent && !opts.password) {"; if(t.split(before).length!==2) throw new Error("Expected one SSH guard"); writeFileSync(p,t.replace(before,after));'
LABEL org.openvalley.repair="system-openssh-docker-auth" org.openvalley.base-revision="234d8a9d0bd571aff3fe3ce73a8408f226dcb4a0"
