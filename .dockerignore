# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
api/.venv/
*.egg-info/
.eggs/
dist/
build/

# Node.js
node_modules/
web/node_modules/
web/.next/
web/public/maplibre/
.npm
*.log

# IDE and editors
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Environment and secrets
.env
.env.*
*.local
api/.env

# Git
.git/
.gitignore
.context/

# Docker (exclude all but prod Dockerfile)
docker-compose*.yml
Dockerfile.db

# Documentation
docs/
*.md
!README.md

# Private and raw data are never part of a public build context. Public images
# copy application code and the explicit releases/ directory only.
data/
warren/outputs/
warren/reviews/
warren/raw_html/
warren/raw_vcgi_snapshots/
private/
raw/
*.csv
*.pdf

# Exclude data JSON files but not config files
data/*.json

# Tests
tests/
*_test.py
test_*.py

# Development files
.serena/
.python-version
scripts/
warren/scripts/

# Temporary files
*.tmp
*.temp
.cache/
