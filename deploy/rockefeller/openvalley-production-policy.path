[Unit]
Description=Watch current Open Valley publication eligibility

[Path]
PathChanged=/srv/storage/files/coding-storage/open-valley/school-board/reports/privacy-exclusions.json
PathChanged=/srv/storage/files/coding-storage/open-valley/school-board/catalog/sources.json
PathChanged=/srv/storage/files/coding-storage/open-valley/school-board/supplements/research-library/library.json
Unit=openvalley-production-policy.service

[Install]
WantedBy=default.target
